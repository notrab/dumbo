{
  "require": {
    "notrab/dumbo": "@dev",
    "league/commonmark": "^2.5",
    "symfony/yaml": "^7.4"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../"
    }
  ],
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "php -S localhost:8000 index.php"
    ],
    "build": [
      "npm run build",
      "@php build.php"
    ]
  },
  "autoload": {
    "psr-4": {
      "Docs\\": "src/"
    },
    "files": [
      "src/helpers.php"
    ]
  }
}
