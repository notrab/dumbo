{
  "require": {
    "notrab/dumbo": "@dev",
    "notrab/jumbo": "^0.1"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../",
      "options": {
        "versions": {
          "notrab/dumbo": "1.x-dev"
        }
      }
    }
  ],
  "scripts": {
    "start": [
      "Composer\\Config::disableProcessTimeout",
      "npm run build",
      "jumbo dev"
    ],
    "build": [
      "npm run build",
      "jumbo build"
    ]
  },
  "autoload": {
    "psr-4": {
      "Docs\\": "src/"
    }
  }
}
