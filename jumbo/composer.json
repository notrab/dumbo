{
  "name": "notrab/jumbo",
  "description": "Content sites on Dumbo: pages from files, layouts, Markdown and static builds.",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/notrab/dumbo",
  "authors": [
    {
      "name": "Jamie Barton",
      "email": "jamie@notrab.dev"
    }
  ],
  "require": {
    "php": ">=8.3",
    "notrab/dumbo": "@dev",
    "league/commonmark": "^2.5",
    "symfony/yaml": "^7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../"
    }
  ],
  "autoload": {
    "psr-4": {
      "Dumbo\\Jumbo\\": "src/"
    },
    "files": [
      "src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Dumbo\\Jumbo\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/jumbo"
  ],
  "scripts": {
    "test": "vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
