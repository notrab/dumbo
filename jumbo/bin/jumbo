#!/usr/bin/env php
<?php

/**
 * jumbo new <directory>
 *     Start a site from the starter
 *
 * jumbo dev [--host=localhost] [--port=8000] [--no-reload]
 *     Serve the site, rendering each page on request and reloading open
 *     pages when a file changes
 *
 * jumbo build [--url=https://example.com] [--base=/sub] [--out=dist]
 *     Render every prerendered page to static files
 *
 * jumbo preview [--out=dist] [--base=/sub] [--host=localhost] [--port=4000]
 *     Serve a build the way a static host would
 *
 * jumbo routes
 *     List the pages and how each is rendered
 *
 * Run it from the project, where app.php returns the site.
 */

use Dumbo\Jumbo\Builder;
use Dumbo\Jumbo\Site;

$root = getcwd();
$command = $argv[1] ?? "help";
$options = [];
$arguments = [];

foreach (array_slice($argv, 2) as $arg) {
    if (preg_match('/^--(url|base|out|host|port)=(.*)$/', $arg, $match)) {
        $options[$match[1]] = $match[2];
    } elseif (preg_match('/^--(no-reload)$/', $arg, $match)) {
        $options[$match[1]] = true;
    } elseif (!str_starts_with($arg, "-")) {
        $arguments[] = $arg;
    } else {
        fwrite(STDERR, "Unknown option $arg\n");
        exit(1);
    }
}

// The starter needs nothing installed yet
if ($command === "new") {
    $target = $arguments[0] ?? null;

    if ($target === null) {
        fwrite(STDERR, "Usage: jumbo new <directory>\n");
        exit(1);
    }

    $target = str_starts_with($target, "/") ? $target : "$root/$target";

    if (is_dir($target) && (new FilesystemIterator($target))->valid()) {
        fwrite(STDERR, "$target isn't empty\n");
        exit(1);
    }

    $starter = dirname(__DIR__) . "/stubs/starter";
    $name = ucwords(str_replace(["-", "_"], " ", basename($target)));
    $files = new RecursiveIteratorIterator(new RecursiveDirectoryIterator($starter, FilesystemIterator::SKIP_DOTS));

    foreach ($files as $file) {
        $path = $target . substr($file->getPathname(), strlen($starter));

        if (!is_dir(dirname($path))) {
            mkdir(dirname($path), 0777, true);
        }

        file_put_contents($path, str_replace("{{name}}", $name, file_get_contents($file->getPathname())));
    }

    $relative = str_starts_with($target, "$root/") ? substr($target, strlen($root) + 1) : $target;

    echo "Created $name in $relative/\n\n  cd " . escapeshellarg($relative) . "\n  composer require notrab/jumbo\n  vendor/bin/jumbo dev\n";
    exit(0);
}

require $GLOBALS["_composer_autoload_path"] ?? (is_file("$root/vendor/autoload.php") ? "$root/vendor/autoload.php" : __DIR__ . "/../vendor/autoload.php");

$output = fn(string $out) => str_starts_with($out, "/") ? $out : "$root/$out";

switch ($command) {
    case "build":
        $_SERVER["DUMBO_ENV"] = "production";
        putenv("DUMBO_ENV=production");

        $site = Site::load($root);

        if (isset($options["url"])) {
            $site->config["url"] = $options["url"];
        }

        $out = $output($options["out"] ?? "dist");
        $builder = new Builder($site, $out, $options["base"] ?? null);

        $files = $builder->build(fn($path) => print("  $path\n"));
        $vendor = count(array_filter($files, fn($file) => str_starts_with($file, "vendor/")));
        $images = count(array_filter($files, fn($file) => str_starts_with($file, "_image/")));

        echo "\nBuilt " . (count($files) - $vendor - $images) . " files, $images resized images and $vendor from node_modules to " . basename($out) . "/\n";

        $actions = array_filter($site->routes(), fn($route) => $route->page?->actions);

        if ($actions !== []) {
            echo "\nThese pages take forms, which need the PHP server rather than a static host:\n";

            foreach ($actions as $route) {
                echo "  $route->path\n";
            }
        }

        if ($builder->broken() !== []) {
            fwrite(STDERR, "\nBroken links:\n");

            foreach ($builder->broken() as $broken) {
                fwrite(STDERR, "  {$broken["page"]} links to {$broken["link"]}\n");
            }
        }
        break;

    case "dev":
        $address = ($options["host"] ?? "localhost") . ":" . ($options["port"] ?? "8000");
        putenv("JUMBO_ROOT=$root");
        putenv("JUMBO_WATCH=" . (isset($options["no-reload"]) ? "0" : "1"));

        // A few workers, so live reload's checks don't hold up pages
        if (getenv("PHP_CLI_SERVER_WORKERS") === false && PHP_OS_FAMILY !== "Windows") {
            putenv("PHP_CLI_SERVER_WORKERS=4");
        }

        echo "Serving on http://$address\n";
        passthru(escapeshellarg(PHP_BINARY) . " -S " . escapeshellarg($address) . " " . escapeshellarg(dirname(__DIR__) . "/src/server.php"), $code);
        exit($code);

    case "preview":
        $out = $output($options["out"] ?? "dist");

        if (!is_file("$out/index.html")) {
            fwrite(STDERR, "No build in " . basename($out) . "/. Run jumbo build first.\n");
            exit(1);
        }

        $base = $options["base"] ?? (is_file("$root/app.php") ? parse_url(Site::load($root)->config["url"] ?? "", PHP_URL_PATH) : null) ?? "";
        $address = ($options["host"] ?? "localhost") . ":" . ($options["port"] ?? "4000");
        putenv("JUMBO_OUT=$out");
        putenv("JUMBO_BASE=" . rtrim($base, "/"));

        echo "Previewing " . basename($out) . "/ on http://$address" . rtrim($base, "/") . "/\n";
        passthru(escapeshellarg(PHP_BINARY) . " -S " . escapeshellarg($address) . " -t " . escapeshellarg($out) . " " . escapeshellarg(dirname(__DIR__) . "/src/preview.php"), $code);
        exit($code);

    case "routes":
        $site = Site::load($root);
        $locales = array_filter($site->locales());

        foreach ($site->routes() as $route) {
            $mode = match (true) {
                $route->page && !$route->page->prerenders($site) => "on demand",
                $route->params !== [] && !$route->page?->paths => "on demand (no paths)",
                default => "prerendered",
            };

            if ($route->page?->actions) {
                $mode .= " + actions";
            }

            printf("  %-28s %-22s %s\n", $route->path, $mode, substr($route->file, strlen("$root/")));
        }

        foreach ($site->redirects() as $path => $redirect) {
            printf("  %-28s %-22s %s\n", $path, "redirect ({$redirect["status"]})", $redirect["to"]);
        }

        if ($locales !== []) {
            echo "\n  Also under " . implode(", ", $locales) . "\n";
        }
        break;

    default:
        fwrite(STDERR, "Usage: jumbo new|dev|build|preview|routes\n");
        exit($command === "help" ? 0 : 1);
}
